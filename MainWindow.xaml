<Window
    x:Class="OnePM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="1pm">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited">

        <Grid.RowDefinitions>
            <!-- Hàng 0: Thanh điều khiển nổi chuẩn macOS Sequoia nằm PHÍA TRÊN ĐỈNH iPhone -->
            <RowDefinition Height="Auto" />
            <!-- Hàng 1: Khung máy iPhone Floating hoàn chỉnh bên dưới, không bị che khuất màn hình -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== MACOS-STYLE TOP PILL BAR (PHÍA TRÊN ĐỈNH IPHONE) ==================== -->
        <Border
            x:Name="FloatingHeaderPill"
            Grid.Row="0"
            Height="34"
            Width="356"
            Margin="0,0,0,8"
            Padding="10,0,8,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="#E61C1C1E"
            BorderBrush="#38FFFFFF"
            BorderThickness="1"
            CornerRadius="17"
            Opacity="0.9"
            PointerPressed="DragRegion_PointerPressed"
            PointerMoved="DragRegion_PointerMoved"
            PointerReleased="DragRegion_PointerReleased">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.18" />
            </Border.OpacityTransition>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cụm nút Traffic Lights kiểu macOS (Đóng, Thu nhỏ, Ghim nổi) -->
                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="CloseWindowBtn"
                        Width="14"
                        Height="14"
                        Padding="0"
                        Background="#FF5F57"
                        BorderThickness="0"
                        CornerRadius="7"
                        Click="CloseWindowBtn_Click"
                        ToolTipService.ToolTip="Đóng ứng dụng" />
                    <Button
                        x:Name="MinimizeWindowBtn"
                        Width="14"
                        Height="14"
                        Padding="0"
                        Background="#FEBC2E"
                        BorderThickness="0"
                        CornerRadius="7"
                        Click="MinimizeWindowBtn_Click"
                        ToolTipService.ToolTip="Thu nhỏ xuống Taskbar" />
                    <Button
                        x:Name="AlwaysOnTopBtn"
                        Width="14"
                        Height="14"
                        Padding="0"
                        Background="#28C840"
                        BorderThickness="0"
                        CornerRadius="7"
                        Click="AlwaysOnTopBtn_Click"
                        ToolTipService.ToolTip="Bật/Tắt ghim luôn nổi trên cùng (Always on Top)" />
                </StackPanel>

                <!-- Tên thiết bị và trạng thái kết nối ở giữa -->
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6">
                    <Ellipse
                        x:Name="StatusDot"
                        Width="7"
                        Height="7"
                        Fill="#FF9F0A" />
                    <TextBlock
                        x:Name="DeviceTitleText"
                        Text="iPhone"
                        Foreground="#E8E8ED"
                        FontSize="12"
                        FontWeight="Medium"
                        VerticalAlignment="Center" />
                </StackPanel>

                <!-- Các nút tác vụ nhanh bên phải (Âm thanh, Xoay full góc, Home, Đa nhiệm, Khởi động lại, Cài đặt) -->
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="3"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="PillAudioBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="AudioButton_Click"
                        ToolTipService.ToolTip="Âm thanh: Đang phát trên iPhone (Nhấp để truyền lên Windows • Chuột phải để chọn)">
                        <FontIcon x:Name="AudioIcon" Glyph="&#xE74F;" FontSize="13" Foreground="#D0D0D5" />
                        <Button.ContextFlyout>
                            <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                <MenuFlyoutItem x:Name="AudioIphoneMenuItem" Text="📱 Phát trên iPhone (Mặc định)" Click="AudioIphone_Click" />
                                <MenuFlyoutItem x:Name="AudioWindowsMenuItem" Text="💻 Truyền lên Windows (Loa PC)" Click="AudioWindows_Click" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                    </Button>
                    <Button
                        x:Name="PillRotateBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="RotateButton_Click"
                        ToolTipService.ToolTip="Xoay màn hình full 4 hướng (Nhấp: xoay 90° • Chuột phải: chọn góc)">
                        <FontIcon Glyph="&#xE7AD;" FontSize="13" Foreground="#D0D0D5" />
                        <Button.ContextFlyout>
                            <MenuFlyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                <MenuFlyoutItem Text="📱 0° - Màn hình dọc chuẩn (Portrait)" Click="Rotate0_Click" />
                                <MenuFlyoutItem Text="🔄 90° - Xoay ngang sang phải" Click="Rotate90_Click" />
                                <MenuFlyoutItem Text="🙃 180° - Dọc lộn ngược (Upside Down)" Click="Rotate180_Click" />
                                <MenuFlyoutItem Text="🔄 270° - Xoay ngang sang trái" Click="Rotate270_Click" />
                            </MenuFlyout>
                        </Button.ContextFlyout>
                    </Button>
                    <Button
                        x:Name="PillHomeBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="HomeButton_Click"
                        ToolTipService.ToolTip="Về màn hình chính (Home)">
                        <FontIcon Glyph="&#xE80F;" FontSize="13" Foreground="#D0D0D5" />
                    </Button>
                    <Button
                        x:Name="PillAppSwitcherBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="AppSwitcherButton_Click"
                        ToolTipService.ToolTip="Mở danh sách đa nhiệm (App Switcher)">
                        <FontIcon Glyph="&#xE7C4;" FontSize="13" Foreground="#D0D0D5" />
                    </Button>
                    <Button
                        x:Name="PillRestartBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="RestartStreamBtn_Click"
                        ToolTipService.ToolTip="Khởi động lại stream màn hình">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" Foreground="#D0D0D5" />
                    </Button>
                    <Button
                        x:Name="PillSettingsBtn"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="Kết nối &amp; Thiết bị (Backend Python)">
                        <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="#D0D0D5" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom" ShouldConstrainToRootBounds="False">
                                <StackPanel Width="270" Spacing="12">
                                    <TextBlock Text="Cài đặt kết nối iPhone" FontWeight="SemiBold" FontSize="14" />

                                    <TextBlock Text="Phương thức truyền stream:" FontSize="12" Foreground="#98989D" />
                                    <ComboBox
                                        x:Name="TransportComboBox"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="0"
                                        SelectionChanged="TransportComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Cáp USB (Siêu nhanh 60fps)" Tag="usb" />
                                        <ComboBoxItem Content="Không dây (Wi-Fi Bonjour)" Tag="wifi" />
                                    </ComboBox>

                                    <TextBlock Text="Đầu ra âm thanh:" FontSize="12" Foreground="#98989D" />
                                    <ComboBox
                                        x:Name="AudioOutputComboBox"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="0"
                                        SelectionChanged="AudioOutputComboBox_SelectionChanged">
                                        <ComboBoxItem Content="📱 Phát trên iPhone (Mặc định)" Tag="iphone" />
                                        <ComboBoxItem Content="💻 Truyền lên Windows (Loa PC)" Tag="windows" />
                                    </ComboBox>

                                    <TextBlock Text="Chọn thiết bị iPhone:" FontSize="12" Foreground="#98989D" />
                                    <ComboBox
                                        x:Name="DeviceComboBox"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="0"
                                        SelectionChanged="DeviceComboBox_SelectionChanged" />

                                    <Button
                                        x:Name="PairWifiBtn"
                                        Content="Ghép nối Wi-Fi một lần qua cáp"
                                        HorizontalAlignment="Stretch"
                                        Click="PairWifiBtn_Click" />

                                    <Button
                                        x:Name="OpenOnboardingBtn"
                                        Content="Kiểm tra hệ thống (Onboarding)"
                                        HorizontalAlignment="Stretch"
                                        Click="OpenOnboardingBtn_Click" />

                                    <!-- Thẻ hướng dẫn gõ tiếng Việt hoàn hảo -->
                                    <Border Background="#242426" CornerRadius="8" Padding="10" Margin="0,2,0,0">
                                        <StackPanel Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE765;" FontSize="12" Foreground="#0A84FF" />
                                                <TextBlock Text="Mẹo gõ Tiếng Việt" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                            </StackPanel>
                                            <TextBlock Text="• Nhấn nút bàn phím trên thanh công cụ để mở ô gõ tiếng Việt siêu tốc (hỗ trợ 100% UniKey/EVKey)." FontSize="11" Foreground="#C7C7CC" TextWrapping="Wrap" />
                                            <TextBlock Text="• Hoặc thêm Bàn phím Tiếng Việt Telex trên iPhone rồi gõ phím trực tiếp." FontSize="11" Foreground="#C7C7CC" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <MenuFlyoutSeparator />

                                    <TextBlock
                                        x:Name="BackendStatusLabel"
                                        Text="Backend: Đang kết nối..."
                                        FontSize="11.5"
                                        Foreground="#8E8E93" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== KHUNG MÁY IPHONE FLOATING (CHASSIS & BEZEL) ==================== -->
        <Border
            x:Name="OuterTitaniumFrame"
            Grid.Row="1"
            Width="356"
            Height="765"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0"
            Background="#000000"
            BorderBrush="#3E3E42"
            BorderThickness="3"
            CornerRadius="44"
            PointerPressed="DragRegion_PointerPressed"
            PointerMoved="DragRegion_PointerMoved"
            PointerReleased="DragRegion_PointerReleased">

            <Grid x:Name="ScreenViewportContainer" CornerRadius="41">
                <!-- WebView2 hiển thị luồng H.265 60fps trực tiếp từ Python backend (http://127.0.0.1:8765/mirror.html) -->
                <WebView2
                    x:Name="MirrorWebView"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    DefaultBackgroundColor="Transparent" />

                <!-- Lớp phủ trạng thái khi đang kết nối iPhone -->
                <Border
                    x:Name="ConnectingOverlay"
                    Background="#E6121214"
                    CornerRadius="41"
                    Visibility="Visible">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="16"
                        Padding="28">
                        <ProgressRing
                            x:Name="ConnectingSpinner"
                            Width="36"
                            Height="36"
                            IsActive="True"
                            Foreground="#0A84FF" />
                        <TextBlock
                            x:Name="OverlayTitleText"
                            Text="Đang kết nối iPhone..."
                            Foreground="White"
                            FontSize="17"
                            FontWeight="SemiBold"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="OverlaySubtitleText"
                            Text="Đang kết nối tới handset.server tại 127.0.0.1:8765..."
                            Foreground="#8E8E93"
                            FontSize="12.5"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxWidth="320"
                            LineHeight="18" />
                        <Button
                            x:Name="RetryConnectBtn"
                            Content="Thử kết nối ngay"
                            HorizontalAlignment="Center"
                            Height="36"
                            Padding="20,0"
                            CornerRadius="18"
                            Background="#0A84FF"
                            Foreground="White"
                            FontWeight="Medium"
                            FontSize="13"
                            Click="ReconnectStreamBtn_Click" />
                    </StackPanel>
                </Border>

                <!-- ==================== GIAO DIỆN ONBOARDING THIẾT LẬP HỆ THỐNG (APPLE HIG) ==================== -->
                <Border
                    x:Name="OnboardingOverlay"
                    Background="#161618"
                    CornerRadius="41"
                    Visibility="Collapsed">
                    <Grid Padding="20,24,20,20">
                        <Grid.RowDefinitions>
                            <!-- Hàng 0: Hero Header Setup Assistant -->
                            <RowDefinition Height="Auto" />
                            <!-- Hàng 1: Apple Inset Grouped List -->
                            <RowDefinition Height="*" />
                            <!-- Hàng 2: Action Area (Capsule CTA Button & Link) -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Hero Squircle Icon & Clean Apple Typography -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4" Margin="0,4,0,16">
                            <!-- Squircle Hero Icon -->
                            <Border
                                Width="56"
                                Height="56"
                                CornerRadius="16"
                                Background="#242426"
                                BorderBrush="#38383A"
                                BorderThickness="1"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,10">
                                <FontIcon Glyph="&#xE7F4;" FontSize="24" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock
                                Text="iPhone Mirroring"
                                Foreground="White"
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                Text="Điều khiển và tương tác với iPhone ngay trên Windows với chuột và bàn phím."
                                Foreground="#8E8E93"
                                FontSize="12"
                                LineHeight="17"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                HorizontalAlignment="Center"
                                Margin="4,2,4,0" />
                        </StackPanel>

                        <!-- Apple Inset Grouped Card Container -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border
                                Background="#1C1C1E"
                                BorderBrush="#2C2C2E"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="0">
                                <StackPanel x:Name="PrerequisitesListPanel" Spacing="0">
                                    <!-- Dynamic rows added by RenderPrerequisiteCards in code-behind -->
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Footer: Progress & Apple Capsule CTA Button -->
                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,4">
                            <!-- Thanh tiến trình cài đặt Apple-style -->
                            <Border
                                x:Name="InstallProgressBox"
                                Background="#1C1C1E"
                                BorderBrush="#2C2C2E"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,8"
                                Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <ProgressBar x:Name="InstallProgressBar" IsIndeterminate="True" Height="3" Foreground="#0A84FF" CornerRadius="1.5" />
                                    <TextBlock
                                        x:Name="InstallStatusLog"
                                        Text="Đang cài đặt..."
                                        FontSize="11.5"
                                        Foreground="#8E8E93"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Apple Primary Capsule CTA Button -->
                            <Button
                                x:Name="MainActionButton"
                                HorizontalAlignment="Stretch"
                                Height="42"
                                CornerRadius="21"
                                Background="#0A84FF"
                                Foreground="White"
                                FontWeight="SemiBold"
                                FontSize="13.5"
                                Click="MainActionButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon x:Name="MainActionIcon" Glyph="&#xE768;" FontSize="13" />
                                    <TextBlock x:Name="MainActionText" Text="Bắt đầu sử dụng" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Text Button -->
                            <Button
                                x:Name="SecondaryActionBtn"
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#8E8E93"
                                FontSize="12"
                                Padding="8,4"
                                Click="SecondaryActionBtn_Click"
                                Content="Kiểm tra lại cấu hình" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic Island mô phỏng (Ẩn khi stream live để không đè lên iOS UI thật) -->
                <Border
                    x:Name="DynamicIslandPill"
                    Width="106"
                    Height="27"
                    Margin="0,11,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#000000"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="13.5"
                    Visibility="Collapsed"
                    PointerPressed="DragRegion_PointerPressed"
                    PointerMoved="DragRegion_PointerMoved"
                    PointerReleased="DragRegion_PointerReleased"
                    DoubleTapped="DynamicIsland_DoubleTapped"
                    ToolTipService.ToolTip="Giữ chuột để kéo cửa sổ iPhone • Nhấp đúp để về Home">
                    <Grid Padding="10,0">
                        <Ellipse
                            Width="9"
                            Height="9"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Fill="#141824"
                            Stroke="#263044"
                            StrokeThickness="1" />
                    </Grid>
                </Border>

                <!-- Home Indicator mô phỏng (Ẩn khi stream live để không đè lên iOS UI thật) -->
                <Border
                    x:Name="HomeIndicatorBar"
                    Width="128"
                    Height="5"
                    Margin="0,0,0,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#B8FFFFFF"
                    CornerRadius="2.5"
                    Visibility="Collapsed"
                    Tapped="HomeIndicator_Tapped"
                    RightTapped="HomeIndicator_RightTapped"
                    ToolTipService.ToolTip="Nhấn: Về màn hình chính (Home) • Chuột phải: Đa nhiệm (App Switcher)" />
            </Grid>
        </Border>
    </Grid>
</Window>